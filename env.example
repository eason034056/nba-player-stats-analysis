# env.example - 環境變數範例檔（Docker Compose 用）
#
# 使用方法：
# 1. 複製此檔案為 .env：cp env.example .env
# 2. 編輯 .env 填入實際的值
# 3. .env 檔案不應該提交到 Git

# ==================== The Odds API 設定 ====================
# 必填：你的 The Odds API 金鑰
# 註冊取得：https://the-odds-api.com/
ODDS_API_KEY=your_api_key_here

# ==================== OpenAI 設定（Agent Chat 用）====================
# Agent 對話功能需要 OpenAI API 金鑰
OPENAI_API_KEY=your_openai_api_key_here

# 選填：API 基礎 URL（通常不需要修改）
ODDS_API_BASE_URL=https://api.the-odds-api.com

# ==================== 快取 TTL 設定（秒）====================
# 選填：賽事列表快取時間
CACHE_TTL_EVENTS=300

# 選填：Props 資料快取時間
CACHE_TTL_PROPS=60

# 選填：球員列表快取時間
CACHE_TTL_PLAYERS=300

# 共享 market snapshot 設定
CACHE_TTL_MARKET_FRESH=600
CACHE_TTL_MARKET_STALE=900
ODDS_REFRESH_LOCK_TTL=10
ODDS_WAIT_FOR_REFRESH_MS=300
ODDS_QUOTA_PROTECT_PERCENT=15
ODDS_HOT_KEYS_LIMIT=10

# ==================== CORS 設定 ====================
# 選填：允許的前端來源（逗號分隔）。不要使用 *。
# CORS_ALLOWED_ORIGINS 有設定時優先。ALLOWED_ORIGINS 是別名，本機 compose 仍可用。
ALLOWED_ORIGINS=http://localhost:3000
# CORS_ALLOWED_ORIGINS=https://<project>.vercel.app
# 預覽站網址用 regex，不要用 *。要同時涵蓋這兩種：
#   https://<project>-git-<branch>-<scope>.vercel.app
#   https://<project>-<hash>-<scope>.vercel.app
# 範例（project=sports-lab、scope=team，上線前再改成真實名稱）：
# CORS_ALLOWED_ORIGIN_REGEX=^https://sports-lab(-git-[a-z0-9-]+-team|-[a-z0-9]+-team)\.vercel\.app$

# Vercel rewrite 與 EC2 之間的共享密鑰。本機留空。
# 產生：openssl rand -hex 32
# 同一個值放到 SSM /sportslab/prod/VERCEL_PROXY_SECRET 和 Vercel 專案環境變數。
# 不要提交、不要貼到聊天。標頭名稱是 x-sportslab-proxy-secret。
# VERCEL_PROXY_SECRET=
# 預設 false。正式環境的 compose 也釘成 false，因為這個 repo 的瀏覽器
# 仍用 NEXT_PUBLIC_API_URL 直接打後端。等 Vercel 改跑 Frontend #63 再打開。
# 打開之後，除了 /api/health 和 /health，每個請求都要帶對的標頭，否則 403。
# 旗標是 true 但密鑰是空的，行程會拒絕啟動。
# PROXY_SECRET_REQUIRED=false

# ==================== 日誌設定 ====================
# 選填：日誌等級（debug, info, warning, error）
LOG_LEVEL=info

# ==================== 前端設定 ====================
# 本機前端不用設 API URL：沒有 BACKEND_API_URL 時，/api/backend 會轉到
# http://localhost:8000。要改目的地時在 frontend/.env.local 設
# BACKEND_API_URL。Vercel 的變數見 docs/deployment/vercel.md。
# BACKEND_API_URL=http://localhost:8000
# 舊的瀏覽器直連變數。#63 之後前端改走 /api/backend，正式環境不要靠這個。
# NEXT_PUBLIC_API_URL=http://localhost:8000

# ==================== PostgreSQL ====================
# 本機預設與 docker-compose 相同。正式環境改成 RDS，並把 SSL 放在 DSN 裡。
# asyncpg 0.30 會從 DSN 讀 sslmode 和 sslrootcert，程式不用再組。
# 正式範例（把 REPLACE_ME 換成真實值，不要提交 .env）：
# DATABASE_URL=postgresql://sportslab_app:REPLACE_ME@REPLACE_ME.rds.amazonaws.com:5432/novig_nba?sslmode=verify-full&sslrootcert=/app/certs/global-bundle.pem
DATABASE_URL=postgresql://novig:novig@localhost:5432/novig_nba

# 本機與測試保持 false。正式環境設 true，Postgres 連不上就不要啟動。
DATABASE_REQUIRED=false

# ==================== AWS（S3 同步與每日 dump；占位符）====================
# 只放占位符。不要把真實 access key 寫進這個檔或提交 .env。
AWS_ACCESS_KEY_ID=REPLACE_ME
AWS_SECRET_ACCESS_KEY=REPLACE_ME
AWS_REGION=us-east-2
S3_BUCKET=REPLACE_ME

# 只給 scripts/db_migrate_to_rds.sh。API 不讀這兩個。
LOCAL_DATABASE_URL=postgresql://novig:novig@localhost:5432/novig_nba
RDS_DATABASE_URL=postgresql://sportslab_admin:REPLACE_ME@REPLACE_ME.rds.amazonaws.com:5432/novig_nba?sslmode=verify-full&sslrootcert=/path/global-bundle.pem
