# env.example - 環境變數範例檔（Docker Compose 用）
#
# 使用方法：
# 1. 複製此檔案為 .env：cp env.example .env
# 2. 編輯 .env 填入實際的值
# 3. .env 檔案不應該提交到 Git

# ==================== BALLDONTLIE（NBA 賠率，必填）====================
# 不要在這個檔案放真的 key。正式環境必須設 BALLDONTLIE_API_KEY。
# 程式裡的每分鐘上限預設仍是 5。正式環境必須設 600。
# https://www.balldontlie.io/
BALLDONTLIE_API_KEY=
BDL_RATE_LIMIT_PER_MIN=600

# ==================== 快取 TTL 設定（秒）====================
# 選填：賽事列表快取時間
CACHE_TTL_EVENTS=300

# 選填：Props 資料快取時間
CACHE_TTL_PROPS=60

# 選填：球員列表快取時間
CACHE_TTL_PLAYERS=300

# 共享 market snapshot 設定
CACHE_TTL_MARKET_FRESH=600
CACHE_TTL_MARKET_STALE=900
ODDS_REFRESH_LOCK_TTL=10
ODDS_WAIT_FOR_REFRESH_MS=300
ODDS_HOT_KEYS_LIMIT=10

# ==================== CORS 設定 ====================
# 選填：允許的前端來源（逗號分隔）
ALLOWED_ORIGINS=http://localhost:3000

# ==================== 日誌設定 ====================
# 選填：日誌等級（debug, info, warning, error）
LOG_LEVEL=info

# ==================== 前端設定 ====================
# 本機前端不用設 API URL：沒有 BACKEND_API_URL 時，/api/backend 會轉到
# http://localhost:8000。要改目的地時在 frontend/.env.local 設
# BACKEND_API_URL。Vercel 的變數見 docs/deployment/vercel.md。
# BACKEND_API_URL=http://localhost:8000
# 本機不設 VERCEL_PROXY_SECRET。正式與 Preview 的值見 frontend/.env.example。
# VERCEL_PROXY_SECRET=replace-with-openssl-rand-hex-32

# ==================== PostgreSQL ====================
# 本機預設與 docker-compose 相同。正式環境改成 RDS，並把 SSL 放在 DSN 裡。
# asyncpg 0.30 會從 DSN 讀 sslmode 和 sslrootcert，程式不用再組。
# 正式範例（把 REPLACE_ME 換成真實值，不要提交 .env）：
# DATABASE_URL=postgresql://sportslab_app:REPLACE_ME@REPLACE_ME.rds.amazonaws.com:5432/novig_nba?sslmode=verify-full&sslrootcert=/app/certs/global-bundle.pem
DATABASE_URL=postgresql://novig:novig@localhost:5432/novig_nba

# 本機與測試保持 false。連線被拒、逾時、或 DNS 失敗時，false 仍會啟動。
# 正式環境設 true，Postgres 連不上就不要啟動。
# 資料庫連得上但 schema_migrations 不是 head 時，不論這個值，啟動都會失敗。
DATABASE_REQUIRED=false

# 預設關閉（不設，或不是 1）。設成 1 時，pytest 會對 DATABASE_URL 指向的
# 資料庫跑 migration。沒設時，下面任一項都會拒絕，而且不會連線：
# - URL 帶 host= 或 hostaddr=（不採用參數值；netloc 已有 host 時 asyncpg 會忽略 host=）
# - 環境裡有 PGHOST 或 PGHOSTADDR
# - netloc host 不是 localhost、127.0.0.1、::1、[::1]、postgres
#   （逗號分隔時每一段都要在名單裡，不分大小寫）
# 沒有 netloc host、也沒有上面的查詢參數和 PGHOST/PGHOSTADDR，是本機 unix socket，允許。
# postgres 留在名單裡是 compose 服務名；這個檢查不查 DNS，名稱仍可能指到遠端。
# CI 有設且不是 false 或 0 時，拒絕會讓整個 session 失敗，而不是 skip。
# ALLOW_REMOTE_TEST_DB=1

# ==================== AWS（S3 同步與每日 dump；占位符）====================
# 只放占位符。不要把真實 access key 寫進這個檔或提交 .env。
AWS_ACCESS_KEY_ID=REPLACE_ME
AWS_SECRET_ACCESS_KEY=REPLACE_ME
AWS_REGION=us-east-2
S3_BUCKET=REPLACE_ME

# 只給 scripts/db_migrate_to_rds.sh。API 不讀這兩個。
LOCAL_DATABASE_URL=postgresql://novig:novig@localhost:5432/novig_nba
RDS_DATABASE_URL=postgresql://sportslab_admin:REPLACE_ME@REPLACE_ME.rds.amazonaws.com:5432/novig_nba?sslmode=verify-full&sslrootcert=/path/global-bundle.pem

# ==================== 官方傷兵報告 PDF（預設關閉）====================
# 設成 true 才會在比賽日每 15 分鐘抓當下那一份。合併進 dev 不會開始抓。
# 檔案只寫進 INJURY_PDF_DIR。沒有 API 路由會把 PDF 送出去。
INJURY_PDF_FETCH_ENABLED=false
INJURY_PDF_DIR=/workspace/nba-injury-pdf

