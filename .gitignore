# .gitignore - Git 忽略檔案清單
#
# 這些檔案和目錄不會被 Git 追蹤

# ==================== 環境變數 ====================
# 包含敏感資訊，不應提交
.env
.env.local
.env.*.local

# nba_lineup_rag 子專案（明確排除）
nba_lineup_rag/.env
nba_lineup_rag/data/

# ==================== Python ====================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
# SPO-20 note: `lib/` (above) is the Python egg/setuptools convention but it
# also sweeps up the Next.js frontend's `frontend/lib/` directory (api.ts,
# schemas.ts, utils.ts, ...). Re-whitelist it explicitly so the frontend's
# shared module layer is actually tracked. Without this, every PR that
# touches `frontend/lib/*` silently drops the changes from the diff.
!frontend/lib/
!frontend/lib/**
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/
.tox/
.nox/
.hypothesis/
venv/
ENV/

# ==================== Node.js ====================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ==================== Next.js ====================
.next/
.next-dev/
out/
.vercel

# ==================== IDE ====================
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store

# ==================== 日誌 ====================
*.log
logs/

# ==================== 快取 ====================
.cache/
*.cache

# ==================== 建置產物 ====================
*.pyc
*.pyo
*.dll
*.dylib

# ==================== 測試覆蓋率 ====================
coverage/
.nyc_output/

# ==================== 其他 ====================
*.local
Thumbs.db

# ==================== SPO-100 generated / local junk ====================
# RAG evaluation exports. Source of truth stays tracked:
# nba_lineup_rag/notebooks/RAG_evaluation.ipynb
nba_lineup_rag/RAG_evaluation.html
nba_lineup_rag/RAG_evaluation.pdf

# Written by RAG_evaluation.ipynb. Nothing in the runtime reads these back.
outputs/notebook_results_*.json
nba_lineup_rag/outputs/notebook_results_*.json

# tsc incremental cache. frontend/.gitignore already lists the frontend file
# by basename; this covers every package from the repo root.
*.tsbuildinfo

# Local env files beyond .env / .env.local above. Keep committed templates.
.env.*
!.env.example
!.env.*.example

# Notebook and tool caches.
.ipynb_checkpoints/
.venv/
.ruff_cache/
.coverage.*
coverage.xml
