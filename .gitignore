# .gitignore - Git 忽略檔案清單
#
# 這些檔案和目錄不會被 Git 追蹤

# ==================== 環境變數 ====================
# 包含敏感資訊，不應提交
.env
.env.local
.env.*.local

# ==================== Python ====================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
# SPO-20 note: `lib/` (above) is the Python egg/setuptools convention but it
# also sweeps up the Next.js frontend's `frontend/lib/` directory (api.ts,
# schemas.ts, utils.ts, ...). Re-whitelist it explicitly so the frontend's
# shared module layer is actually tracked. Without this, every PR that
# touches `frontend/lib/*` silently drops the changes from the diff.
!frontend/lib/
!frontend/lib/**
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/
.tox/
.nox/
.hypothesis/
venv/
ENV/

# ==================== Node.js ====================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ==================== Next.js ====================
.next/
.next-dev/
# Next.js export directory.
out/
.vercel

# ==================== IDE ====================
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store

# ==================== 日誌 ====================
*.log
logs/

# ==================== 快取 ====================
.cache/
*.cache
# SPO-138 backfill: raw BALLDONTLIE pages, kept locally (python -m app.backfill --raw-dir).
bdl-raw/
# SPO-149: official NBA injury-report PDFs. Local cache only. Do not commit them.
nba-injury-pdf/
# SPO-151: local unmatched-name review. Do not commit it.
injury-report-unmatched/

# ==================== 建置產物 ====================
*.pyc
*.pyo
*.dll
*.dylib

# ==================== 測試覆蓋率 ====================
coverage/
.nyc_output/

# ==================== 其他 ====================
*.local
Thumbs.db

# tsc incremental cache. frontend/.gitignore already lists the frontend file
# by basename; this covers every package from the repo root.
*.tsbuildinfo

# Local env files beyond .env / .env.local above. Keep committed templates.
.env.*
!.env.example
!.env.*.example

# ==================== Terraform ====================
# Local state, plans, and variable files. Commit only *.tfvars.example.
.terraform/
**/.terraform/
*.tfstate
*.tfstate.*
crash.log
crash.*.log
*.tfplan
*.tfvars
!*.tfvars.example

# Notebook and tool caches.
.ipynb_checkpoints/
.venv/
.ruff_cache/
.coverage.*
coverage.xml

# SPO-158 baseline trainer. The short metrics file and the model card are
# committed. Dataset exports, fitted models, per-player dumps, and official
# injury PDFs stay local.
*.parquet
*.joblib
*.pkl
*.pdf
**/player_level_predictions.*
