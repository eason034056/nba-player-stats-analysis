# Server-only backend origin. next.config.js reads this when it builds
# the rewrite from /api/backend/:path* to this host. It has no
# NEXT_PUBLIC_ prefix, so Next.js does not inline it into the browser bundle.
#
# Local `next dev` and a local `next build` (VERCEL and VERCEL_ENV unset)
# use http://localhost:8000 when this variable is missing. Leave it unset
# for that. Do not put a real host, password, or API key in this file.
#
# On Vercel, set it in the project environment variables:
#   Production — the production backend origin, for example https://api.example.com
#   Preview    — the same origin, or a staging origin if you have one
# A Production or Preview build fails when this is missing.
# Changing it requires a new deployment. The rewrite destination is fixed at build time.

BACKEND_API_URL=https://api.example.com

# Vercel sets these on its own builds. Do not set them in local .env files.
# A non-empty VERCEL or VERCEL_ENV with no BACKEND_API_URL fails the build.
# VERCEL=
# VERCEL_ENV=
